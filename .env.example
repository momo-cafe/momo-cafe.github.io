# Copy to .env and fill in. .env is gitignored; never commit a token.
#
# The site builds fine with none of these set: src/lib/content.js falls back to
# src/content/*.json and says so in the build log.

# Read token for the Sanity dataset (project drw50awd, dataset production).
# Only needed while the dataset is private. Create one with Viewer permissions:
#   https://www.sanity.io/manage/project/drw50awd/api  ->  Tokens  ->  Add API token
# In CI, set it as a repository secret and expose it to the build step.
SANITY_READ_TOKEN=

# Write token, used ONLY by `node scripts/seed-sanity.mjs` to push the JSON in
# src/content into the dataset once. Needs Editor permissions, same page as
# above. Do not put this one in CI: nothing in the build ever writes.
SANITY_WRITE_TOKEN=

# Set to `local` to skip Sanity entirely and build straight from
# src/content/*.json. Useful offline, and while editing that JSON by hand.
#   MOMO_CONTENT=local npm run build
MOMO_CONTENT=

# Unrelated to Sanity, but the other build-time switch worth knowing about:
# allows a pre-launch build while business.kvk and business.btwId are still
# placeholders. Remove it from .github/workflows/deploy.yml once they are real.
#   MOMO_ALLOW_PLACEHOLDERS=1 npm run build
