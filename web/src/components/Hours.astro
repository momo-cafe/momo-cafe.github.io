---
/**
 * The most-visited block on the page. Consecutive identical days collapse into
 * ranges, so the current data is two rows and not seven.
 *
 * Today's row is marked by the client script, not at build time: a static build
 * would bake in the date it was built and then lie for six days.
 */
import { t } from '../lib/t.js';
import { groupedHours, groupLabel, rangeLabel } from '../lib/hours.js';

interface Props {
	hours: Record<string, any>;
	ui: Record<string, any>;
	locale: string;
}

const { hours, ui, locale } = Astro.props;
const groups = groupedHours(hours);
---

<dl class="hours u-num">
	{
		groups.map((group) => (
			<div class="hours__row" data-days={group.days.join(',')}>
				<dt>{groupLabel(group, locale)}</dt>
				<dd>{rangeLabel(group.ranges) ?? t(ui.closedDay, locale)}</dd>
			</div>
		))
	}
</dl>

<style>
	/* The day column is sized to its content, not to a fixed width: the type
	   scales with the viewport (--utility is derived from --u, which is 100vw
	   based) so any fixed rem column is outgrown somewhere between the mobile
	   breakpoint and desktop. "ma-vr" then breaks at its hyphen, which is a
	   legal break point, and a day range reads as two lines of nonsense. */
	.hours {
		display: grid;
		grid-template-columns: max-content auto;
		gap: 0.15rem 0.75rem;
		font-size: var(--utility);
		color: var(--glass-ink);
	}

	/* Rows stay real elements for the is-today marker, but borrow the parent's
	   columns so every row lines up. */
	.hours__row {
		display: grid;
		/* Fallback first: without subgrid each row sizes its own columns, which
		   still never wraps, it just stops guaranteeing cross-row alignment. */
		grid-template-columns: max-content auto;
		gap: 0.75rem;
		grid-template-columns: subgrid;
		grid-column: 1 / -1;
	}

	.hours__row dt {
		/* Belt and braces: never break a day range across lines. */
		white-space: nowrap;
	}

	.hours__row dd {
		margin: 0;
	}

	.hours__row.is-today {
		color: var(--ink);
	}
</style>
