---
/**
 * The menu as real HTML text. No PDF, no photograph of a menu card.
 *
 * Each section is a 5/7 split: the narrow column holds the section name at
 * display size, the wide one holds the price list. Rows are separated by
 * hairlines rather than sitting in a card, and the € appears once per section
 * heading, never on a row — the price column is tabular so it lines up, and a
 * repeated currency symbol makes it wobble.
 *
 * Three shapes come out of the printed cards:
 *   - items:      a name, an optional note, an optional add-on, a price
 *   - groupPrice: one price against the whole section (sweets), with the
 *                 choices listed beneath and no per-line price
 *   - footnote:   real content belonging to a section, not fine print
 * Prices stay exactly as printed ("2,9", "3,9 / 4,5"): parsing them into
 * numbers would render 2,90 and lose the second size.
 */
import { t } from '../lib/t.js';

interface Props {
	menu: Record<string, any>;
	ui: Record<string, any>;
	locale: string;
	/** Anchor id of the allergen block the codes link to. */
	allergensId?: string;
}

const { menu, ui, locale, allergensId = 'allergenen' } = Astro.props;
const codes = menu.allergenCodes ?? {};
---

<div class="menu">
	{
		menu.sections.map((section: any) => (
			<section class="course" id={section.id} aria-labelledby={`heading-${section.id}`}>
				<div class="course__head">
					<h3 id={`heading-${section.id}`} class="course__name u-fun">
						{t(section.heading, locale)}
					</h3>
					{section.footnote && <p class="course__footnote">{t(section.footnote, locale)}</p>}
				</div>

				<div class="course__list">
					{/* The currency sits once, at the head of the price column, so no
					    row has to repeat it. For a group-priced section it carries
					    that section's single price. */}
					<p class="course__euro u-num">{section.groupPrice ? `€ ${section.groupPrice}` : '€'}</p>

					<ul class="course__rows">
					{(section.items ?? []).map((item: any, index: number) => (
						<li class="row u-reveal" style={`--reveal-i:${index}`}>
							<p class="row__name">
								{item.highlight && <span class="row__dot" aria-hidden="true" />}
								{t(item.name, locale)}
								{(item.allergens ?? []).length > 0 && (
									<sup class="row__allergens">
										{item.allergens.map((code: string) => (
											<a
												href={`#${allergensId}-${code}`}
												aria-label={t(codes[code], locale)}
												class="u-num"
											>
												{code.toLowerCase()}
											</a>
										))}
									</sup>
								)}
							</p>
							<p class="row__price u-num">{item.price}</p>
							{item.note && <p class="row__note">{t(item.note, locale)}</p>}
							{item.addOn && <p class="row__note row__add">{t(item.addOn, locale)}</p>}
						</li>
					))}

					{/* One price against the whole group: the choices carry no price. */}
					{(section.options ?? []).map((option: any, index: number) => (
						<li class="row u-reveal" style={`--reveal-i:${index}`}>
							<p class="row__name">{t(option, locale)}</p>
						</li>
					))}
					</ul>
				</div>
			</section>
		))
	}

	<p class="menu__order u-utility">{t(menu.orderNotice, locale)}</p>
</div>

<style>
	.menu {
		display: grid;
	}

	.course {
		display: grid;
		grid-template-columns: 5fr 7fr;
		column-gap: calc(40 * var(--u));
		padding-top: calc(60 * var(--u));
	}

	.course__name {
		font-size: var(--h2);
	}

	.course__euro {
		margin: 0 0 calc(8 * var(--u));
		text-align: right;
		font-size: var(--utility);
		color: var(--glass-ink);
		white-space: nowrap;
	}

	.course__footnote {
		margin-top: calc(20 * var(--u));
		max-width: 28ch;
		font-size: var(--utility);
		line-height: 1.5;
		letter-spacing: 0.04em;
		color: var(--glass-ink);
		/* The card breaks this across two lines, and so does the JSON. */
		white-space: pre-line;
	}

	.course__rows {
		display: grid;
		align-content: start;
	}

	/* Every division is a hairline; nothing here is a box. */
	.row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		column-gap: calc(30 * var(--u));
		align-items: baseline;
		border-top: var(--hair) solid var(--glass);
		padding-block: calc(16 * var(--u));
	}

	.row:last-child {
		border-bottom: var(--hair) solid var(--glass);
	}

	.row__name {
		grid-column: 1;
	}

	.row__price {
		grid-column: 2;
		text-align: right;
		font-size: var(--utility);
		color: var(--glass-ink);
	}

	.row__note {
		grid-column: 1 / -1;
		max-width: var(--measure);
		margin-top: calc(4 * var(--u));
		font-size: var(--utility);
		line-height: 1.45;
		letter-spacing: 0.04em;
		color: var(--glass-ink);
	}

	.row__add {
		color: var(--ink);
	}

	/* --zon, at most twice on a screen: here it is a highlight dot. */
	.row__dot {
		display: inline-block;
		width: 0.4rem;
		height: 0.4rem;
		margin-right: 0.45rem;
		border-radius: 50%;
		background: var(--zon);
		vertical-align: 0.1em;
	}

	.row__allergens {
		margin-left: 0.35rem;
		font-size: 0.625rem;
		line-height: 1;
	}

	.row__allergens a {
		color: var(--glass-ink);
		text-decoration: none;
		margin-left: 0.12rem;
	}

	.row__allergens a:hover {
		color: var(--ink);
		text-decoration: underline;
	}

	.menu__order {
		margin: 0;
		padding-top: calc(40 * var(--u));
	}

	@media (max-width: 63.9375rem) {
		.course {
			grid-template-columns: 1fr;
			row-gap: calc(24 * var(--u));
			padding-top: calc(48 * var(--u));
		}

		.course__footnote {
			max-width: none;
		}
	}
</style>
