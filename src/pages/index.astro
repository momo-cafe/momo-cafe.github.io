---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Momo Cafe">
	<h1>Momo Cafe</h1>
	<p>
		This is a static Astro site. Every push to <code>main</code> builds it and publishes
		the result to GitHub Pages.
	</p>
	<p>
		Edit <code>src/pages/index.astro</code> to change this page, or add a new
		<code>.astro</code> file under <code>src/pages/</code> to add a route.
	</p>
</Layout>
